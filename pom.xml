<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.telcobright</groupId>
    <artifactId>statewalk</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <name>Statewalk</name>
    <description>Registry-driven state machine framework: pooling, supervisor/child cells, per-state timeouts, quota admission, persistence + rehydration (JDBC/Redis/in-memory), session base (generic SessionSupervisor + SDR + history). v3: single core stack, per-borrow epoch identity, atomic cell lifecycle claims, chain-serialized timeouts, unconditional terminal guarantees. Standalone library repo since 2026-09-01; formerly routesphere/statewalk-v2.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- SLF4J API only — consumer provides the binding (logback / log4j2 / jul). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>

        <!-- Jackson for context JSON serialization (only used when persistence is enabled). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>

        <!-- Redis persistence provider (optional — consumers who use
             RedisPersistenceProvider add jedis themselves; everyone else
             pays nothing). -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.2.0</version>
            <optional>true</optional>
        </dependency>

        <!-- Tests: visible log output via slf4j-simple. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.1</version>
            <scope>test</scope>
        </dependency>
        <!-- MySQL-backed rehydration tests (self-skip when no server on
             127.0.0.1:3306). Connector 8.4.x — the last line supporting the
             MySQL 5.7 servers still in the fleet; 9.x needs 8.0+. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
        </plugins>
    </build>
</project>
